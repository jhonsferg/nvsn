export NVSN_DIR='/home/jo/Mi Dir/.nvsn'
export NVSN_SHELL=bash
export NVSN_VERSION='v20.11.1'
_nvsn_rest=
_nvsn_ifs=$IFS
_nvsn_noglob=0
case $- in *f*) _nvsn_noglob=1 ;; *) set -f ;; esac
IFS=:
for _nvsn_d in $PATH; do
    if [ -n "$_nvsn_d" ] && [ "$_nvsn_d" != "${NVSN_PATH_ENTRY-}" ]; then
        _nvsn_rest="${_nvsn_rest:+$_nvsn_rest:}$_nvsn_d"
    fi
done
IFS=$_nvsn_ifs
[ "$_nvsn_noglob" = 1 ] || set +f
unset _nvsn_ifs _nvsn_noglob _nvsn_d
PATH='/home/jo/Mi Dir/.nvsn/versions/v20.11.1/bin'
if [ -n "$_nvsn_rest" ]; then PATH="$PATH:$_nvsn_rest"; fi
export PATH
unset _nvsn_rest
export NVSN_PATH_ENTRY='/home/jo/Mi Dir/.nvsn/versions/v20.11.1/bin'

if ! declare -f _nvsn_hook >/dev/null 2>&1; then
_nvsn_has_version_file() {
    _nvsn_d="$PWD"
    while :; do
        if [ -f "$_nvsn_d/.nvmrc" ] || [ -f "$_nvsn_d/.node-version" ]; then
            return 0
        fi
        case "$_nvsn_d" in
            /) return 1 ;;
        esac
        _nvsn_d="${_nvsn_d%/*}"
        [ -n "$_nvsn_d" ] || _nvsn_d=/
    done
}
_nvsn_hook() {
    [ -n "${NVSN_SHELL_VERSION-}" ] && return 0
    [ "$PWD" = "${_NVSN_PREV_PWD-}" ] && return 0
    _NVSN_PREV_PWD="$PWD"
    if _nvsn_has_version_file; then
        _NVSN_AUTO=1
    elif [ -n "${_NVSN_AUTO-}" ]; then
        unset _NVSN_AUTO
        if command -v nvsn > /dev/null 2>&1; then eval "$(command nvsn deactivate --shell bash 2>/dev/null)"; eval "$(command nvsn env --shell bash 2>/dev/null)"; fi
        return 0
    else
        return 0
    fi
    command -v nvsn > /dev/null 2>&1 || return 0
    eval "$(command nvsn __hook --shell bash 2>/dev/null)"
}
_nvsn_deactivate() {
    _nvsn_out="$(command nvsn deactivate --shell bash)" || return $?
    eval "$_nvsn_out"
    unset NVSN_SHELL_VERSION _NVSN_AUTO
    _NVSN_PREV_PWD="$PWD"
}
PROMPT_COMMAND="_nvsn_hook${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
fi
